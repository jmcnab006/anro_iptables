{{ ansible_managed | comment }}

{#
 # ---------------------------------------------------------------------------
 # RAW TABLE
 # ---------------------------------------------------------------------------
 #}
{% if
  _anro_iptables_ipv6_raw_rules | length > 0
  or _anro_iptables_ipv6_raw_chains | length > 0
%}
*raw
:PREROUTING ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

{# Custom chains. #}
{% for chain in _anro_iptables_ipv6_raw_chains %}
:{{ chain.name | upper }} - [0:0]
{% endfor %}

{# Table rules. #}
{% for rule in _anro_iptables_ipv6_raw_rules %}
{{ rule }}
{% endfor %}

{# Custom chain rules. #}
{% for chain in _anro_iptables_ipv6_raw_chains %}
{% for rule in chain.ipv6 %}
-A {{ chain.name | upper }} {{ rule }}
{% endfor %}
{% endfor %}

COMMIT

{% endif %}
